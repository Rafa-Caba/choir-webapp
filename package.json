{
  "name": "choir-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('.test-dist', { recursive: true, force: true }))\" && tsc -p tsconfig.tests.json && node .test-dist/tests/run.js",
    "verify:qa": "npm run typecheck && npm run lint && npm run build && npm test && npm run verify:contracts",
    "verify:contracts": "node scripts/verify-web-contracts.mjs"
  },
