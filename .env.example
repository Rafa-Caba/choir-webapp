# .env.example

# HTTP API origin. The Web App appends /api exactly once.
VITE_API_URL=http://localhost:10000

# Optional Socket.IO origin. Leave empty to reuse VITE_API_URL origin.
VITE_SOCKET_URL=http://localhost:10000

# Optional redirect for /. Leave empty to show the neutral platform landing.
VITE_DEFAULT_PUBLIC_CHOIR_CODE=

# Axios timeout in milliseconds. Minimum: 1000.
VITE_API_REQUEST_TIMEOUT_MS=12000
