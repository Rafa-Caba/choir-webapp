# .env

# API origin. The Web App adds /api for HTTP calls and keeps the origin for Socket.IO.
VITE_API_URL=http://localhost:10000

# Optional public redirect for /. Leave empty to show the neutral platform landing.
# VITE_DEFAULT_PUBLIC_CHOIR_CODE=coro-a

# Axios timeout in milliseconds. Minimum: 1000.
VITE_API_REQUEST_TIMEOUT_MS=12000